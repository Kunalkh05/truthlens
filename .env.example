# TruthLens AI Environment Configuration
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production credentials to source control.

# Application
NODE_ENV=development
PORT=3000

# Database Configuration
# Defaults to local SQLite database in data/truthlens.db
# For production PostgreSQL: postgresql://user:password@host:5432/truthlens
DATABASE_URL=

# Secure Key Management (SKM) Vault
# Master Key Encryption Key (KEK) secret for envelope encryption (AES-256-GCM)
# In production, provide a 32+ character random secret or configure KMS provider
SKM_MASTER_KEY=
SKM_KEY_ID=kek_dev_local_v1
SKM_KEK_PROVIDER=local

# Primary AI Provider: Google Gemini
# If left empty, TruthLens operates in deterministic local offline mode
GEMINI_API_KEY=

# Secondary AI Provider: OpenRouter (Fallback)
OPENROUTER_API_KEY=

# Object Storage Configuration
# Defaults to local filesystem storage in storage/uploads and storage/derivatives
# For S3/GCS blob storage:
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Search & Egress Configuration
SEARCH_PROVIDER_API_KEY=

# Optional Cloudflare Worker backend proxy (server token is never exposed to browser code)
NEXT_PUBLIC_TRUTHLENS_CLOUD_API=false
TRUTHLENS_CLOUDFLARE_API_URL=
TRUTHLENS_CLOUDFLARE_API_TOKEN=
